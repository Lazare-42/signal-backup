# Signal importer configuration
# Copy this file to .env and adjust values as needed.

# Path to Signal Desktop SQLite database (desktop_messages.db)
# Example: exported archive path
SIGNAL_DB=./Signal-Archive/Signal/desktop_messages.db

# PostgreSQL connection settings
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=message_unifier
PG_USER=postgres
PG_PASSWORD=

# Notes:
# - CLI flags override these env values.
# - Empty PG_PASSWORD means passwordless auth (e.g., local trust/peer auth).
# - If using a different DB path, update SIGNAL_DB accordingly.